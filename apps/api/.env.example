DB_HOST="localhost"
DB_PORT=5433
DB_NAME="schedule"
DB_URL="postgresql://admin:root@localhost:5433/schedule"

JWT_SECRET="dev_access_secret_change_me"
JWT_REFRESH_SECRET="dev_refresh_secret_change_me"
